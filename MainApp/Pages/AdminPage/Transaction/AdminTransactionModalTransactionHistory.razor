@using MainApp.Components.Accordion
@using MainApp.Components.Badge
@using MainApp.Components.Card
@using MainApp.Components.Loader
@using MainApp.Components.Modal

<Modal @ref="_modal"
       Size="Size.Md"
       IsCloseButtonVisible="false"
       ModalContentStyle="@($"bg-{Theme.Light.ToString().ToLower()}-subtle")">
    <Title>
        @Label.AppAdminBankTransactionHistoryTitle
    </Title>
    <Body>
        <div class="row pb-4 align-items-center">
            <p class="h5">@Label.AppAdminBankTransactionHistoryMessage1</p>
            @if (_isLoading)
            {
                <div class="col-auto">
                    <Loader />
                </div>
            }
            else
            {
                <div class="col-auto">
                    <label for="FinancialInstitution" class="col-form-label">@Label.AppAdminBankTransactionHistoryFieldFinancialInstitution</label>
                </div>
                <div class="d-flex col-auto align-items-center">
                    <select id="FinancialInstitution"
                            @attributes="_inputFormAttributes.Select"
                            @bind="_bankTransactionHistoryModel.BankId">
                        <option value="0">@Label.AppFieldSelect</option>
                        @foreach (var (bank, index) in _banks.Select((value, index) => (value, index)))
                        {
                            <option value="@bank.Id"> @($"{bank.Description} - {bank.CurrentBalance.ToString("C")}") </option>
                        }
                    </select>
                    <button class="btn btn-@(Size.Sm.ToString().ToLower()) btn-@(Theme.Secondary.ToString().ToLower()) @("rounded"+_appSettings.Button) border-0 ms-2 d-inline"
                            disabled="@(_isProcessing || _bankTransactionHistoryModel.BankId == 0)"
                            @onclick="() => SearchAsync()">
                            @(_isProcessing ? Label.AppButtonSearching : Label.AppButtonSearch)
                    </button>
                </div>
            }
        </div>
        <div class="row p-2">
            <div class="col-sm-12">
                @if (_isProcessing)
                {
                    <Loader />
                }
                else
                {
                    @foreach (var (item, index) in _bankTransactionHistoryListView.Select((value, index) => (value, index)))
                    {
                        <div class="row pb-3">
                            <div class="col-12">
                                <span class="text-@(Theme.Secondary.ToString().ToLower())">
                                    @($"{item.BDate.ToString("dddd, d MMM yyyy")}")
                                </span>
                            </div>
                            <CardView Styles="border-0 shadow-sm bg-secondary-subtle">
                                <CardMiddle Styles="p-0">
                                    <div class="table-responsive">
                                        <table class="table table-borderless">
                                            <thead>
                                                <tr>
                                                    <th class="col-auto" colspan="3">
                                                    </th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (_bankTransactionHistoryListView.Count <= 0)
                                                {
                                                    <tr>
                                                        <td class="text-center" colspan="3">
                                                            <div>
                                                                @Label.AppNoRecordFound
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                                else
                                                {
                                                    foreach (var record in _bankTransactionHistoryListView[index].Transactions)
                                                    {
                                                        <tr>
                                                            <td colspan="3"></td>
                                                            <td class="text-end p-0">
                                                                <sub>
                                                                    @($"{Label.AppAdminBankTransactionHistoryColumnCurrentBalance} {record.CurrentBalance.ToString("C")}")
                                                                </sub>
                                                                @if (record.Action == TransactionActionType.D.ToString())
                                                                {
                                                                    <div class="text-end text-@(Theme.Danger.ToString().ToLower())">
                                                                        @record.Amount.ToString("C")
                                                                    </div>
                                                                }
                                                                else
                                                                {
                                                                    <div class="text-end text-@(Theme.Primary.ToString().ToLower())">
                                                                        @record.Amount.ToString("C")
                                                                    </div>
                                                                }
                                                            </td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </CardMiddle>
                            </CardView>
                        </div>
                    }
                }
            </div>
        </div>
        @if (_hasMore)
        {
            <div class="row p-2">
                <div class="col-12 d-flex justify-content-center">
                    <button class="btn btn-@(Size.Sm.ToString().ToLower()) btn-outline-@(Theme.Primary.ToString().ToLower()) @("rounded"+_appSettings.Button)"
                        disabled="@(_isProcessingLoad || _bankTransactionHistoryModel.BankId == 0)"
                        @onclick="() => LoadMoreAsync()">
                        @(_isProcessingLoad ? Label.AppButtonLoading : Label.AppButtonLoadMore)
                    </button>
                </div>
            </div>
        }
    </Body>
    <Footer>
        <div class="row">
            <div class="col-auto">
                <button type="button"
                        class="btn btn-@(Size.Sm.ToString().ToLower()) btn-outline-@(Theme.Secondary.ToString().ToLower()) @("rounded"+_appSettings.Button)"
                        data-dismiss="modal"
                        @onclick="() => CloseModalAsync()">
                    @Label.AppButtonClose
                </button>
            </div>
        </div>
    </Footer>
</Modal>
