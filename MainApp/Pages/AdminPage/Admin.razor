@page "/admin"

@using MainApp.Components.Page
@using MainApp.Components.Card
@using MainApp.Components.Chart.Bank
@using MainApp.Components.Chart.Expense
@using MainApp.Components.Chart.Transaction
@using MainApp.Components.Message
@using MainApp.Components.Shared

<div class="container-lg">
    <AuthorizeView Policy="Admin">
        <Authorized>
            <PageWrapper>
                <PageTopView>
                    <PageTopWrapper>
                        <div class="d-flex align-items-baseline">
                            <PageTopTitle Title="@(Label.AppMenuAdmin)" />
                        </div>
                    </PageTopWrapper>
                </PageTopView>
                <PageMiddleView>
                    <PageMiddleWrapper>
                        <div class="row">
                            <div class="col-sm-12 col-lg-6">
                                <div class="app-sticky-cardview">
                                    <CardView Styles="border-0 app-bg-animation mb-3">
                                        <CardMiddle>
                                        <div class="row">
                                            <div class="col-auto d-flex align-items-center">
                                                <div class="flex-grow-1 p-5 @($"text-{Theme.Dark.ToString().ToLower()}")">
                                                    <h3 class="fs-1 mb-5">@Label.AppPageAdminTitle</h3>
                                                    <p class="fs-5">@Label.AppPageAdminParagraph</p>
                                                </div>
                                            </div>
                                        </div>
                                        </CardMiddle>
                                    </CardView>
                                </div>
                            </div>
                            <div class="col-sm-12 col-lg-6 pb-4">
                                <CardView Styles="border-0 mb-3">
                                    <CardMiddle>
                                        <div class="row g-0">
                                            <div class="col-md-4 d-flex align-items-center justify-content-center">
                                                <i class="bi bi-cart4 fs-1 py-3 px-4"></i>
                                            </div>
                                            <div class="col-md-8">
                                                <h3 class="fs-5 text-body-emphasis">@Label.AppMenuAdminExpense</h3>
                                                <p class="fs-6 @($"text-{Theme.Secondary.ToString().ToLower()}")">
                                                    @Label.AppPageAdminExpenseParagraph1
                                                </p>
                                                <div class="d-flex justify-content-end">
                                                    <a href="@EndPoint.AdminExpenses" class="d-flex btn btn-sm @($"btn-outline-{Theme.Primary.ToString().ToLower()}") @("rounded"+_appSettings.Button)">
                                                        @Label.AppButtonVisitPage
                                                        <i class="bi bi-chevron-right"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </CardMiddle>
                                </CardView>
                                <CardView Styles="border-0 mb-3">
                                    <CardMiddle>
                                        <div class="row g-0">
                                            <div class="col-md-4 d-flex align-items-center justify-content-center">
                                                <i class="bi bi-clock-history fs-1 py-3 px-4"></i>
                                            </div>
                                            <div class="col-md-8">
                                                <h3 class="fs-5 text-body-emphasis">@Label.AppMenuAdminTimesheet</h3>
                                                <p class="fs-6 @($"text-{Theme.Secondary.ToString().ToLower()}")">
                                                    @Label.AppPageAdminTimesheetParagraph1 
                                                </p>
                                                <div class="d-flex justify-content-end">
                                                    <a href="@EndPoint.AdminTimesheet"class="btn btn-sm @($"btn-outline-{Theme.Primary.ToString().ToLower()}") @("rounded"+_appSettings.Button)">
                                                        @Label.AppButtonVisitPage
                                                        <i class="bi bi-chevron-right"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </CardMiddle>
                                </CardView>
                                <CardView Styles="border-0 mb-3">
                                    <CardMiddle>
                                        <div class="row g-0">
                                            <div class="col-md-4 d-flex align-items-center justify-content-center">
                                                <i class="bi bi-currency-exchange fs-1 py-3 px-4"></i>
                                            </div>
                                            <div class="col-md-8">
                                                <h3 class="fs-5 text-body-emphasis">@Label.AppMenuAdminTransaction</h3>
                                                <p class="fs-6 @($"text-{Theme.Secondary.ToString().ToLower()}")">
                                                    @Label.AppPageAdminTransactionParagraph1
                                                </p>
                                                <div class="d-flex justify-content-end">
                                                    <a href="@EndPoint.AdminTransactions" class="btn btn-sm @($"btn-outline-{Theme.Primary.ToString().ToLower()}") @("rounded"+_appSettings.Button)">
                                                        @Label.AppButtonVisitPage
                                                        <i class="bi bi-chevron-right"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </CardMiddle>
                                </CardView>
                                <CardView Styles="border-0 mb-3">
                                    <CardMiddle>
                                        <div class="row g-0">
                                            <div class="col-md-4 d-flex align-items-center justify-content-center">
                                                <i class="bi bi-pin-map fs-1 py-3 px-4"></i>
                                            </div>
                                            <div class="col-md-8">
                                                <h3 class="fs-5 text-body-emphasis">@Label.AppMenuAdminTrip</h3>
                                                <p class="fs-6 @($"text-{Theme.Secondary.ToString().ToLower()}")">
                                                    @Label.AppPageAdminTripParagraph1
                                                </p>
                                                <div class="d-flex justify-content-end">
                                                    <a href="@EndPoint.AdminTrips"class="btn btn-sm @($"btn-outline-{Theme.Primary.ToString().ToLower()}") @("rounded"+_appSettings.Button)">
                                                        @Label.AppButtonVisitPage
                                                        <i class="bi bi-chevron-right"></i>
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </CardMiddle>
                                </CardView>
                            </div>
                        </div>
                    </PageMiddleWrapper>
                </PageMiddleView>
                <PageBottomView />
            </PageWrapper>
        </Authorized>
        <NotAuthorized>
            <NotAuthorizedMessage />
        </NotAuthorized>
    </AuthorizeView>
</div>
