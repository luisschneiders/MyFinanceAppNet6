@using MainApp.Components.Card

<CardView Styles="border-0">
    <CardMiddle Styles="p-0">
        <div @onclick="SetSettingsDateTime">
            <div class="btn btn-@(Theme.Dark.ToString().ToLower()) d-flex w-100 align-items-center @("rounded"+Radius)">
                <i class="bi bi-calendar2-heart fs-5"></i>
                <div class="w-100 text-start ps-3 pe-2">
                    <span class="d-block mb-1">@Label.AppSettingDateTime</span>
                    <small>@Label.AppSettingDateTimeParagraph</small>
                </div>
                <div>
                    <i class="bi bi-chevron-right"></i>
                </div>
            </div>
        </div>
    </CardMiddle>
</CardView>
