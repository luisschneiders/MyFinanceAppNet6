@using MainApp.Components.Card

<CardView Styles="border-0 mb-3">
    <CardMiddle>
        <div class="row g-0">
            <div class="col-md-4 d-flex align-items-center justify-content-center">
                <i class="bi bi-ui-checks-grid fs-1 py-3 px-4"></i>
            </div>
            <div class="col-md-8">
                <h3 class="fs-5 text-body-emphasis">@Label.AppSettingInterface</h3>
                <p class="fs-6 @($"text-{Theme.Secondary.ToString().ToLower()}")">@Label.AppSettingInterfaceParagraph</p>
                <div class="d-flex justify-content-end">
                    <a @onclick="SetSettingsButtonsForms" class="d-flex btn btn-sm @($"btn-outline-{Theme.Primary.ToString().ToLower()}") @("rounded"+_appSettings.Button)">
                        @Label.AppButtonCustomise
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </CardMiddle>
</CardView>
